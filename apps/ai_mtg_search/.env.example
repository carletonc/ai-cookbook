# AI MTG Search — environment configuration
#
# Copy to .env and fill in. .env is gitignored; never commit it.
# Card data is owned by the external `mtg-db` repo. This app is READ-ONLY.
# See README.md for how to run this app.

# --- Neon Postgres (required) ---
# TODO: this should point at a READ-ONLY Neon role, not the ETL role.
# Create one in the Neon SQL editor:
#   CREATE ROLE mtg_reader WITH LOGIN PASSWORD '...';
#   GRANT CONNECT ON DATABASE neondb TO mtg_reader;
#   GRANT USAGE ON SCHEMA public TO mtg_reader;
#   GRANT SELECT ON cards, embeddings, sync_log TO mtg_reader;
# Then swap the credentials in the connection string below.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# --- Query embedding backend ---
# Must produce vectors comparable to what mtg-db wrote: MiniLM, 384-dim, cosine.
# "fastembed"   — ONNX runtime, ~80MB install (fits Streamlit Cloud's 1GB cap)
# "huggingface" — sentence-transformers + torch, byte-identical to mtg-db but ~1GB
EMBEDDING_BACKEND=fastembed
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Chat LLM (planner + ranker) — OpenAI-compatible ---
# Visitors do not paste a key; put the app key in .env / Streamlit secrets.
# Default host is Groq free tier. Swap base_url + model for HF, OpenAI, or xAI.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
# Optional aliases (first match wins): LLM_API_KEY, HF_TOKEN, OPENAI_API_KEY, GROK_API_KEY
# Soft daily cap across the Streamlit process (0 disables):
LLM_DAILY_REQUEST_CAP=800

# Examples for other hosts:
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_TOKEN=
#
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-4.3
# GROK_API_KEY=
#
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-nano
# OPENAI_API_KEY=
